# Copy to .env. Credentials stay in your own terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
DATA_DIR=.data/telegram
TIMEZONE=Asia/Taipei
CHAT_CORE=pyramid
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-chat
LLM_MAX_TOKENS=768
LLM_TIMEOUT_SECONDS=180
CHAT_MODEL_REPO=unsloth/Qwen3.5-9B-GGUF
CHAT_MODEL_QUANT=Q4_K_M
HF_HOME=.local/huggingface
ROUTER_MODE=off
PERSONA_POLICY_BACKEND=rules
# Optional image runtime; weights download only on an explicit request.
IMAGE_PYTHON=.venv-image/bin/python
IMAGE_MODEL=z-image-turbo
IMAGE_MODEL_PATH=
IMAGE_QUANTIZE=4
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STEPS=9
IMAGE_TIMEOUT_SECONDS=900
